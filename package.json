{
    "name": "@openhps/react-native",
    "version": "0.1.8",
    "description": "Open Hybrid Positioning System",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-react-native.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "module": "./dist/esm/index.js",
    "es2015": "./dist/esm/index.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./imu": {
            "types": "./dist/types/nodes/IMUSourceNode.d.ts",
            "import": "./dist/esm/nodes/IMUSourceNode.js",
            "require": "./dist/cjs/nodes/IMUSourceNode.js"
        },
        "./geolocation": {
            "types": "./dist/types/nodes/GeolocationSourceNode.d.ts",
            "import": "./dist/esm/nodes/GeolocationSourceNode.js",
            "require": "./dist/cjs/nodes/GeolocationSourceNode.js"
        },
        "./wlan": {
            "types": "./dist/types/nodes/WLANSourceNode.d.ts",
            "import": "./dist/esm/nodes/WLANSourceNode.js",
            "require": "./dist/cjs/nodes/WLANSourceNode.js"
        },
        "./ble": {
            "types": "./dist/types/nodes/BLESourceNode.d.ts",
            "import": "./dist/esm/nodes/BLESourceNode.js",
            "require": "./dist/cjs/nodes/BLESourceNode.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*"
    ],
    "scripts": {
        "test": "mocha --config test/.mocharc.json",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "clean": "shx rm -rf ./dist && shx rm -rf ./docs/out",
        "build": "npm run clean && npm-run-all --parallel build:ts:*",
        "build:typedoc": "typedoc --options docs/typedoc.json",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "prepare": "husky",
        "build:ts:cjs": "tsc --build ./tsconfig/tsconfig.bundle.cjs.json",
        "build:ts:esm": "tsc --build ./tsconfig/tsconfig.bundle.esm.json && node ./scripts/finalize-esm.mjs",
        "build:ts:types": "tsc --build ./tsconfig/tsconfig.bundle.types.json",
        "build:quick": "npm-run-all --parallel build:ts:*"
    },
    "keywords": [
        "openhps",
        "react-native"
    ],
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@openhps/core": ">=1.0.16 <2",
        "@openhps/rf": ">=1.0.4 <2",
        "react-native": ">=0.71.3 <1",
        "reflect-metadata": ">=0.2.2 <1"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "react-native-ble-plx": ">=2.0.3",
        "react-native-device-info": ">=10.4.0",
        "react-native-geolocation-service": ">=5.3.1",
        "react-native-sensors": ">=7.3.6",
        "react-native-wifi-reborn": ">=4.7.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@openhps/core": "^1.0.16",
        "@openhps/rf": "^1.0.4",
        "@types/chai": "^5.2.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "react-native": "^0.71.3",
        "react-native-ble-plx": "^2.0.3",
        "react-native-device-info": "^10.4.0",
        "react-native-geolocation-service": "^5.3.1",
        "react-native-sensors": "^7.3.6",
        "react-native-wifi-reborn": "^4.7.0",
        "reflect-metadata": ">=0.1.13",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2",
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint",
            "pre-push": "npm run test",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
